---
import LanguageSwitcher from "./LanguageSwitcher.astro";
const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-[#0B0E12]">
  <div class="mx-auto flex max-w-content flex-col items-center justify-between gap-6 px-5 py-10 sm:flex-row sm:px-8">
    <a href="#top" aria-label={t.nav.top}>
      <img class="h-10 w-auto dark:hidden" src="/img/horizontal_logo.webp" alt="Aleix Casas" width="180" height="40" />
      <img class="hidden h-10 w-auto dark:block" src="/img/horizontal_logo_inverted.webp" alt="Aleix Casas" width="180" height="40" />
    </a>

    <div class="flex flex-col items-center gap-4 sm:flex-row">
      <LanguageSwitcher lang={t.lang} label={t.nav.language} />
      <div class="flex items-center gap-3">
        <a
          href="https://www.linkedin.com/in/aleixcaasas/"
          target="_blank"
          rel="noopener"
          class="grid h-10 w-10 place-items-center rounded-md border border-zinc-300 transition-colors hover:border-accent dark:border-zinc-700 dark:bg-zinc-200"
          aria-label="LinkedIn"
        >
          <img class="h-5 w-5" src="/img/linkedin.webp" alt="" width="20" height="20" />
        </a>
        <a
          href="https://github.com/aleixcaasas"
          target="_blank"
          rel="noopener"
          class="grid h-10 w-10 place-items-center rounded-md border border-zinc-300 transition-colors hover:border-accent dark:border-zinc-700 dark:bg-zinc-200"
          aria-label="GitHub"
        >
          <img class="h-5 w-5" src="/img/github.webp" alt="" width="20" height="20" />
        </a>
        <a
          href="mailto:acasasbarco@gmail.com"
          class="grid h-10 w-10 place-items-center rounded-md border border-zinc-300 transition-colors hover:border-accent dark:border-zinc-700"
          aria-label="Email"
        >
          <img class="h-5 w-5" src="/img/envelope.webp" alt="" width="20" height="20" />
        </a>
      </div>
    </div>

    <p class="font-mono text-xs text-zinc-500 dark:text-zinc-400">© {year} Aleix Casas Barco</p>
  </div>
</footer>
