---
import SectionTitle from "./SectionTitle.astro";
const { t } = Astro.props;
---

<section id="projects" class="mx-auto w-full max-w-content px-5 py-16 sm:px-8 sm:py-20">
  <SectionTitle kicker={t.projects.kicker} title={t.projects.title} />

  <p class="-mt-4 mb-10 max-w-[65ch] text-zinc-600 dark:text-zinc-400">{t.projects.intro}</p>

  <div class="flex flex-col gap-8">
    {
      t.projects.items.map((p) => (
        <article class="overflow-hidden rounded-lg border border-zinc-200 bg-white transition-shadow hover:shadow-lg dark:border-zinc-800 dark:bg-[#151A21]">
          {p.image && (
            <img
              class="aspect-[16/9] w-full border-b border-zinc-200 bg-zinc-50 object-cover object-top dark:border-zinc-800 dark:bg-zinc-900"
              src={p.image}
              alt={p.imageAlt}
              loading="lazy"
            />
          )}

          <div class="flex flex-col gap-4 p-5 sm:p-7">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h3 class="font-display text-xl font-semibold sm:text-2xl">{p.name}</h3>
              <p class="shrink-0 font-mono text-xs text-zinc-500 dark:text-zinc-400">{p.context} · {p.year}</p>
            </div>

            <p class="font-display text-base font-medium text-accent sm:text-lg">{p.tagline}</p>

            <p class="max-w-[70ch] text-zinc-700 dark:text-zinc-300">{p.summary}</p>

            <ul class="flex list-disc flex-col gap-2 pl-5 marker:text-accent">
              {p.highlights.map((h) => (
                <li class="max-w-[70ch] text-[0.95rem] leading-relaxed text-zinc-700 dark:text-zinc-300">{h}</li>
              ))}
            </ul>

            <ul class="mt-1 flex flex-wrap gap-2">
              {p.stack.map((s) => (
                <li class="rounded border border-zinc-200 bg-zinc-50 px-2 py-1 font-mono text-xs text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{s}</li>
              ))}
            </ul>

            {p.gallery && (
              <ul class="mt-2 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
                {p.gallery.map((g) => (
                  <li class="flex flex-col gap-2">
                    <a
                      href={g.src}
                      target="_blank"
                      rel="noopener"
                      class="group block overflow-hidden rounded-md border border-zinc-200 bg-zinc-50 transition-colors hover:border-accent dark:border-zinc-700 dark:bg-zinc-900"
                    >
                      <img
                        class="aspect-[16/10] w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.03]"
                        src={g.src}
                        alt={g.alt}
                        loading="lazy"
                      />
                    </a>
                    <p class="text-xs leading-relaxed text-zinc-500 dark:text-zinc-400">{g.caption}</p>
                  </li>
                ))}
              </ul>
            )}

            {p.note && (
              <p class="border-t border-zinc-100 pt-4 text-sm italic text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">{p.note}</p>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
