---
import SectionTitle from "./SectionTitle.astro";
import habilidades from "../config/habilidades.json";
---

<section id="skills" class="mx-auto w-full max-w-content px-5 py-16 sm:px-8 sm:py-20">
  <SectionTitle kicker="What I work with" title="Skills" />

  <dl class="grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2">
    {
      habilidades.map((group) => (
        <div>
          <dt class="font-mono text-xs uppercase tracking-[0.14em] text-zinc-500 dark:text-zinc-400">
            {group.group}
          </dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded border border-zinc-200 px-2.5 py-1 text-sm text-zinc-700 dark:border-zinc-700 dark:text-zinc-300">
                  {item}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>
