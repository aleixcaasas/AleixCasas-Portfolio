---
const links = [
  { href: "#about", label: "About" },
  { href: "#experience", label: "Experience" },
  { href: "#projects", label: "Projects" },
  { href: "#skills", label: "Skills" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="sticky top-0 z-40 w-full border-b border-zinc-200 bg-white/85 backdrop-blur dark:border-zinc-800 dark:bg-[#0E1116]/85"
>
  <nav
    class="mx-auto flex h-16 max-w-content items-center justify-between gap-4 px-5 sm:px-8"
    aria-label="Main"
  >
    <a href="#top" class="flex shrink-0 items-center" aria-label="Aleix Casas — home">
      <img
        class="h-9 w-auto dark:hidden"
        src="/img/horizontal_logo.webp"
        alt="Aleix Casas"
        width="160"
        height="36"
      />
      <img
        class="hidden h-9 w-auto dark:block"
        src="/img/horizontal_logo_inverted.webp"
        alt="Aleix Casas"
        width="160"
        height="36"
      />
    </a>

    <!-- Escritorio -->
    <ul class="hidden items-center gap-7 md:flex">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="relative py-1 text-sm font-semibold tracking-wide text-zinc-700 transition-colors after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-full after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 hover:text-ink hover:after:scale-x-100 dark:text-zinc-300 dark:hover:text-white"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle dark mode"
        class="grid h-10 w-10 place-items-center rounded-md border border-zinc-300 text-zinc-700 transition-colors hover:border-accent hover:text-accent dark:border-zinc-700 dark:text-zinc-300"
      >
        <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>

      <a
        href="/CV_Aleix_Casas.pdf"
        target="_blank"
        rel="noopener"
        class="hidden rounded-md border-2 border-ink px-4 py-2 text-sm font-bold transition-colors hover:border-accent hover:text-accent sm:inline-block dark:border-zinc-200 dark:hover:border-accent"
        >Download CV</a
      >

      <button
        id="nav-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-10 w-10 place-items-center rounded-md border border-zinc-300 text-zinc-700 md:hidden dark:border-zinc-700 dark:text-zinc-300"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Móvil -->
  <div
    id="mobile-menu"
    class="hidden border-t border-zinc-200 bg-white px-5 pb-4 md:hidden dark:border-zinc-800 dark:bg-[#0E1116]"
  >
    <ul class="flex flex-col">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="block border-b border-zinc-100 py-3 font-semibold text-zinc-700 dark:border-zinc-800 dark:text-zinc-300"
            >
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/CV_Aleix_Casas.pdf"
          target="_blank"
          rel="noopener"
          class="mt-4 block rounded-md border-2 border-ink py-3 text-center font-bold dark:border-zinc-200"
          >Download CV</a
        >
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var t = document.getElementById("theme-toggle");
    if (t) {
      t.addEventListener("click", function () {
        var dark = document.documentElement.classList.toggle("dark");
        try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
      });
    }
    var b = document.getElementById("nav-toggle");
    var m = document.getElementById("mobile-menu");
    if (b && m) {
      b.addEventListener("click", function () {
        var open = m.classList.toggle("hidden") === false;
        b.setAttribute("aria-expanded", String(open));
        b.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      });
      m.addEventListener("click", function (e) {
        if (e.target.tagName === "A") {
          m.classList.add("hidden");
          b.setAttribute("aria-expanded", "false");
        }
      });
    }
  })();
</script>
