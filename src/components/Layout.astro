---
import "../styles/input.css";
const { t } = Astro.props;
const url = "https://aleixcaasas.netlify.app";
const paths = { en: "/", es: "/es/", ca: "/ca/" };
const canonical = url + paths[t.lang];
---

<!doctype html>
<html lang={t.lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/img/small_logo.webp" />

    <link rel="alternate" hreflang="en" href={url + "/"} />
    <link rel="alternate" hreflang="es" href={url + "/es/"} />
    <link rel="alternate" hreflang="ca" href={url + "/ca/"} />
    <link rel="alternate" hreflang="x-default" href={url + "/"} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.lang} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={url + "/img/horizontal_logo.webp"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Quicksand:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="bg-white font-sans text-ink antialiased transition-colors dark:bg-[#0E1116] dark:text-zinc-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
      >{t.nav.skip}</a
    >
    <slot />
  </body>
</html>
