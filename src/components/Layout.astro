---
import "../styles/input.css";

const title = "Aleix Casas — Software Engineer";
const description =
  "Software Engineer in Barcelona. I build and operate backend systems that have to hold up: Python/Django over PostgreSQL, LLM features in production, and Kubernetes on GCP.";
const url = "https://aleixcaasas.netlify.app";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/img/small_logo.webp" />

    <!-- Open Graph: así el enlace se ve bien al pegarlo en LinkedIn o WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${url}/img/horizontal_logo.webp`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Kanit:wght@500;600;700&family=Quicksand:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Tema antes de pintar, para que no haya parpadeo blanco en modo oscuro -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.classList.toggle("dark", dark);
        } catch (e) {}
      })();
    </script>
  </head>
  <body
    class="bg-white font-sans text-ink antialiased transition-colors dark:bg-[#0E1116] dark:text-zinc-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
