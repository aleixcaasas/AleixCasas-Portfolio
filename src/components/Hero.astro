---
const { t } = Astro.props;
---

<section id="top" class="mx-auto w-full max-w-content px-5 pt-14 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
  <div class="flex flex-col-reverse items-start gap-8 md:flex-row md:items-center md:gap-14">
    <div class="w-full">
      <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent sm:text-sm">{t.hero.location}</p>
      <h1 class="mt-3 font-display text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">Aleix Casas</h1>
      <p class="mt-3 font-display text-lg font-medium text-zinc-600 sm:text-2xl dark:text-zinc-300">{t.hero.role}</p>
      <p class="mt-6 max-w-[62ch] text-base leading-relaxed text-zinc-700 sm:text-lg dark:text-zinc-300">{t.hero.intro}</p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#projects" class="rounded-md bg-ink px-5 py-3 text-sm font-bold text-white transition-colors hover:bg-accent dark:bg-zinc-100 dark:text-ink dark:hover:bg-accent dark:hover:text-white">{t.hero.cta}</a>
        <a href={t.nav.cvFile} target="_blank" rel="noopener" class="rounded-md border-2 border-ink px-5 py-[10px] text-sm font-bold transition-colors hover:border-accent hover:text-accent dark:border-zinc-300 dark:hover:border-accent">{t.nav.cv}</a>
        <a
          href="https://www.linkedin.com/in/aleixcaasas/"
          target="_blank"
          rel="noopener"
          class="grid h-11 w-11 place-items-center rounded-md border border-zinc-300 transition-colors hover:border-accent dark:border-zinc-700 dark:bg-zinc-200"
          aria-label="LinkedIn"
        >
          <img class="h-5 w-5" src="/img/linkedin.webp" alt="" width="20" height="20" />
        </a>
        <a
          href="https://github.com/aleixcaasas"
          target="_blank"
          rel="noopener"
          class="grid h-11 w-11 place-items-center rounded-md border border-zinc-300 transition-colors hover:border-accent dark:border-zinc-700 dark:bg-zinc-200"
          aria-label="GitHub"
        >
          <img class="h-5 w-5" src="/img/github.webp" alt="" width="20" height="20" />
        </a>
      </div>
    </div>

    <div class="shrink-0">
      <img
        class="h-28 w-28 rounded-full object-cover ring-4 ring-zinc-100 sm:h-40 sm:w-40 dark:ring-zinc-800"
        src="/img/fotoCarnet.webp"
        alt="Aleix Casas"
        width="160"
        height="160"
      />
    </div>
  </div>
</section>
