---
const { lang, label } = Astro.props;
const locales = [
  { code: "en", href: "/", short: "EN", name: "English" },
  { code: "ca", href: "/ca/", short: "CA", name: "Català" },
  { code: "es", href: "/es/", short: "ES", name: "Español" },
];
---

<nav aria-label={label} class="flex items-center rounded-md border border-zinc-300 dark:border-zinc-700">
  {
    locales.map((l, i) => (
      <a
        href={l.href}
        hreflang={l.code}
        lang={l.code}
        aria-current={l.code === lang ? "true" : undefined}
        title={l.name}
        class:list={[
          "px-2.5 py-2 font-mono text-xs font-semibold transition-colors",
          i === 0 && "rounded-l-[4px]",
          i === locales.length - 1 && "rounded-r-[4px]",
          l.code === lang
            ? "bg-ink text-white dark:bg-zinc-100 dark:text-ink"
            : "text-zinc-600 hover:text-accent dark:text-zinc-400 dark:hover:text-accent",
        ]}
      >
        {l.short}
      </a>
    ))
  }
</nav>
