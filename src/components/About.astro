---
import SectionTitle from "./SectionTitle.astro";
const { t } = Astro.props;
---

<section id="about" class="mx-auto w-full max-w-content px-5 py-16 sm:px-8 sm:py-20">
  <SectionTitle kicker={t.about.kicker} title={t.about.title} />

  <div class="flex max-w-[68ch] flex-col gap-4 text-zinc-700 dark:text-zinc-300">
    {t.about.paragraphs.map((p) => <p>{p}</p>)}
  </div>
</section>
