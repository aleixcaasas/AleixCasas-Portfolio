---
import SectionTitle from "./SectionTitle.astro";
const { t } = Astro.props;
---

<section id="experience" class="mx-auto w-full max-w-content px-5 py-16 sm:px-8 sm:py-20">
  <SectionTitle kicker={t.experience.kicker} title={t.experience.title} />

  <ol class="flex flex-col gap-10">
    {
      t.experience.jobs.map((job) => (
        <li class="border-l-2 border-zinc-200 pl-5 sm:pl-7 dark:border-zinc-800">
          <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <h3 class="font-display text-lg font-semibold sm:text-xl">
              {job.role} <span class="text-accent">·</span> {job.company}
            </h3>
            <p class="shrink-0 font-mono text-xs text-zinc-500 sm:text-sm dark:text-zinc-400">
              {job.period} · {job.location}
            </p>
          </div>

          <p class="mt-3 max-w-[70ch] text-zinc-700 dark:text-zinc-300">{job.summary}</p>

          <ul class="mt-4 flex list-disc flex-col gap-2 pl-5 marker:text-accent">
            {job.points.map((p) => (
              <li class="max-w-[70ch] text-[0.95rem] leading-relaxed text-zinc-700 dark:text-zinc-300">{p}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
